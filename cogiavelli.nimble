version     = "0.1.0"
author      = "daveey"
description = "Cogiavelli: Diplomacy's adjudicator on a Renaissance-Italy board with a treasury bolted on. Six powers, three seasons a year, simultaneous orders, and ducats that buy the enemy's army; a policy is just a prompt."
license     = "MIT"

srcDir = "src"

requires "nim >= 2.2.4"
requires "bitworld >= 0.1.0"
requires "mummy >= 0.4.7"
requires "curly >= 1.1.1"
requires "whisky"
